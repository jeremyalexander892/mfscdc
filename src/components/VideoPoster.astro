---
import { Image } from "astro:assets";
import { Play } from "@lucide/astro";
import poster from "../assets/images/team-portrait.jpeg";

interface Props {
  /** Same-origin MP4 (H.264/AAC, faststart). */
  src: string;
  /** Same-origin English WebVTT captions. */
  captions: string;
  /** Shown on the download link, e.g. "MP4, 39 MB". */
  sizeLabel: string;
  title: string;
}

const { src, captions, sizeLabel, title } = Astro.props;
---

<div
  class="video"
  data-video-src={src}
  data-video-captions={captions}
  data-video-title={title}
  data-reveal
>
  <button type="button" class="poster" aria-label={`Play video: ${title}`}>
    <Image
      src={poster}
      alt=""
      widths={[480, 720, 960, 1280]}
      sizes="(min-width: 64rem) 34rem, 100vw"
      class="poster-img"
    />
    <span class="poster-scrim" aria-hidden="true"></span>
    <span class="play" aria-hidden="true">
      <Play size={30} fill="currentColor" stroke-width={0} class="play-icon" />
      <span class="spinner"></span>
    </span>
  </button>
  <p class="fallback" role="status">
    <span class="error-text">The video couldn't load.</span>
    <span class="hint-text">Video not playing?</span>{" "}
    <a href={src} download>
      Download the video ({sizeLabel})
    </a>
  </p>
</div>

<script>
  // Click-to-load: the ~39 MB MP4 is only requested once a visitor asks for it,
  // so the page itself stays as light as before.
  document.querySelectorAll<HTMLElement>(".video[data-video-src]").forEach((root) => {
    const button = root.querySelector<HTMLButtonElement>(".poster");
    const { videoSrc, videoCaptions, videoTitle } = root.dataset;
    if (!button || !videoSrc) return;

    const reveal = (video: HTMLVideoElement) => {
      if (root.dataset["state"] === "playing") return;
      root.dataset["state"] = "playing";
      button.remove();
      video.focus();
    };

    const fail = () => {
      root.dataset["state"] = "error";
      root.querySelector("video.player")?.remove();
      button.removeAttribute("aria-busy");
      button.disabled = true;
    };

    button.addEventListener(
      "click",
      () => {
        root.dataset["state"] = "loading";
        button.setAttribute("aria-busy", "true");

        const video = document.createElement("video");
        video.className = "player";
        video.controls = true;
        video.playsInline = true;
        video.preload = "auto";
        video.setAttribute("aria-label", videoTitle ?? "Video");

        const source = document.createElement("source");
        source.src = videoSrc;
        source.type = "video/mp4";
        // A failed <source> fires "error" on the source element, not the video.
        source.addEventListener("error", fail);
        video.append(source);

        if (videoCaptions) {
          const track = document.createElement("track");
          track.kind = "captions";
          track.srclang = "en";
          track.label = "English";
          track.src = videoCaptions;
          // Off by default: viewers turn captions on from the player's CC control. Browsers that
          // honor a system-wide captions preference (e.g. Safari) still switch them on automatically.
          video.append(track);
        }

        video.addEventListener("playing", () => reveal(video), { once: true });
        root.prepend(video);
        // The click is a user gesture, so playback with sound is allowed. If the browser still
        // refuses (e.g. iOS Low Power Mode), show the player so its own controls can start it.
        video.play().catch((err: unknown) => {
          const blocked = err instanceof DOMException && err.name === "NotAllowedError";
          if (blocked) reveal(video);
          else fail();
        });
      },
      { once: true },
    );
  });
</script>

<style>
  .video {
    position: relative;
    display: grid;
    gap: var(--space-xs);
  }

  .poster,
  .video :global(.player) {
    grid-area: 1 / 1;
    inline-size: 100%;
    aspect-ratio: 16 / 10;
    border: 0;
    border-radius: var(--radius-media);
    box-shadow: var(--shadow-media);
  }

  /* The film is 16:9; letterbox it inside the 16:10 frame so the layout never shifts. */
  .video :global(video.player) {
    block-size: auto;
    object-fit: contain;
    background: var(--brand-navy-deep);
  }

  .video :global(video.player:focus-visible) {
    outline: 3px solid var(--brand-lime);
    outline-offset: 3px;
  }

  .poster {
    position: relative;
    padding: 0;
    overflow: hidden;
    cursor: pointer;
    background: var(--brand-navy-deep);
  }

  .poster-img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .poster-scrim {
    position: absolute;
    inset: 0;
    background: rgb(4 22 80 / 0.25);
    transition: background-color var(--duration) var(--ease-out);
  }

  .poster:hover .poster-scrim {
    background: rgb(4 22 80 / 0.15);
  }

  .play {
    position: absolute;
    inset: 50% auto auto 50%;
    translate: -50% -50%;
    inline-size: 5rem;
    block-size: 5rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--brand-lime);
    color: var(--brand-navy);
    box-shadow: var(--shadow-cta);
    transition: scale var(--duration) var(--ease-out);
  }

  .play :global(.play-icon) {
    translate: 2px 0;
  }

  .poster:hover .play {
    scale: 1.06;
  }

  .spinner {
    display: none;
    inline-size: 2rem;
    block-size: 2rem;
    border-radius: 50%;
    border: 3px solid rgb(7 46 110 / 0.25);
    border-block-start-color: var(--brand-navy);
  }

  .video[data-state="loading"] .play :global(.play-icon) {
    display: none;
  }

  .video[data-state="loading"] .spinner {
    display: block;
    animation: spin 0.8s linear infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .video[data-state="loading"] .spinner {
      animation-duration: 2.4s;
    }
  }

  @keyframes spin {
    to {
      rotate: 1turn;
    }
  }

  .fallback {
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  .error-text {
    display: none;
    font-weight: 700;
    color: var(--ink);
  }

  .video[data-state="error"] .error-text {
    display: inline;
  }

  .video[data-state="error"] .hint-text,
  .video[data-state="error"] .play {
    display: none;
  }

  .poster:disabled {
    cursor: default;
  }
</style>
