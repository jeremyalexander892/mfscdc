---
const steps = [
  {
    title: "Schedule the visit",
    text: "Your medical team shares the patient list and priorities.",
  },
  {
    title: "The clinic arrives",
    text: "A team member coordinates with officials and staff throughout the day.",
  },
  {
    title: "Treatment on site",
    text: "Exams, routine care and emergencies, all inside the perimeter.",
  },
  {
    title: "Records returned",
    text: "Treatment notes go back to your team to keep health records complete.",
  },
];
---

<section id="how-it-works" class="section section--surface" aria-labelledby="steps-title">
  <div class="container steps">
    <header class="steps-head" data-reveal>
      <p class="eyebrow">How it works</p>
      <h2 id="steps-title" class="section-title">
        One treatment day, start to finish
      </h2>
    </header>
    <ol class="step-grid">
      {steps.map((step, i) => (
        <li class="step crown" data-reveal>
          <span class="step-num" aria-hidden="true">
            {String(i + 1).padStart(2, "0")}
          </span>
          <h3>
            <span class="visually-hidden">Step {i + 1}: </span>
            {step.title}
          </h3>
          <p>{step.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .steps-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-s);
    text-align: center;
  }

  .step-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14.5rem), 1fr));
    gap: var(--space-m);
  }

  .step {
    background: var(--white);
    border-radius: var(--radius-card);
    padding: calc(var(--space-l) + var(--crown)) var(--space-l) var(--space-l);
    display: flex;
    flex-direction: column;
    gap: 0.625rem;

    & h3 {
      font-size: 1.1875rem;
      font-weight: 800;
    }

    & p {
      font-size: 1rem;
      color: var(--ink-muted);
    }
  }

  .step-num {
    font-family: var(--font-display);
    font-size: 2.75rem;
    line-height: 1;
    color: var(--brand-green);
  }
</style>
