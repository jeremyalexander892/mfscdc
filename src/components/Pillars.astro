---
import { FileCheck, ShieldCheck, TrendingDown, Truck } from "@lucide/astro";

const pillars = [
  { icon: ShieldCheck, title: "Secure on site", text: "Patients never leave your perimeter." },
  { icon: TrendingDown, title: "Cost-effective", text: "No escorts, vehicles or overtime." },
  { icon: Truck, title: "Comprehensive care", text: "A full clinic, routine to emergency." },
  { icon: FileCheck, title: "Records & HIPAA", text: "EHR kept with your medical team." },
];
---

<section id="services" class="pillars" aria-labelledby="pillars-title">
  <h2 id="pillars-title" class="visually-hidden">
    What we bring to your facility
  </h2>
  <ul class="container pillar-grid stagger">
    {pillars.map(({ icon: Icon, title, text }) => (
      <li class="pillar" data-reveal>
        <span class="pillar-badge" aria-hidden="true">
          <Icon size={30} stroke-width={1.75} class="pillar-icon" />
        </span>
        <h3 class="pillar-title">{title}</h3>
        <p>{text}</p>
      </li>
    ))}
  </ul>
</section>

<style>
  .pillars {
    border-block-end: 1px solid var(--border);
    padding-block: var(--space-2xl);
  }

  /* 1px gaps over a border-coloured background draw the dividers at any column count. */
  .pillar-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9.5rem), 1fr));
    gap: 1px;
    background: var(--border);
  }

  .pillar {
    background: var(--white);
    padding: var(--space-m) clamp(var(--space-xs), 2vw, var(--space-l));
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.625rem;

    & p {
      font-size: 1rem;
      color: var(--ink-muted);
    }
  }

  /* Green brand icon on a pale-lime disc, echoing the flyer's green icons.
     Green is 3.87:1 on white, fine for non-text graphics (WCAG 1.4.11). */
  .pillar-badge {
    display: grid;
    place-items: center;
    inline-size: 4rem;
    block-size: 4rem;
    border-radius: 50%;
    background: var(--accent-tint);
    color: var(--brand-green);
    margin-block-end: 0.25rem;
    transition:
      background-color var(--duration) var(--ease-out),
      color var(--duration) var(--ease-out),
      scale var(--duration) var(--ease-out);
  }

  @media (prefers-reduced-motion: no-preference) {
    .pillar:hover .pillar-badge {
      scale: 1.06;
    }
  }

  .pillar-title {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
</style>
