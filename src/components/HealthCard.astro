---
import { ArrowRight } from "@lucide/astro";
import { TESTIMONIAL } from "../content/site";
---

<section id="oral-health" class="health" aria-labelledby="health-title">
  <div class="glow" aria-hidden="true"></div>
  <div class="container">
    <div class="card crown" data-reveal>
      <div class="stack">
        <p class="eyebrow">Oral health is whole-body health</p>
        <h2 id="health-title" class="card-title">
          Healthy mouths help manage systemic disease
        </h2>
        <p class="lede">
          Studies associate poor oral health with cardiovascular disease, diabetes, dementia,
          rheumatoid arthritis and several cancers. Dental plaque can harbor respiratory pathogens
          in high-risk groups, including people in custody.
        </p>
        <p class="lede">
          Regular, on-site dental care is one of the most practical ways to improve outcomes for
          your population.
        </p>
        <a href="#contact" class="text-link">
          Talk to us about equitable access
          <ArrowRight size={18} aria-hidden="true" />
        </a>
      </div>
      <figure class="quote">
        <span class="quote-mark" aria-hidden="true">
          “
        </span>
        <blockquote>
          <p>{TESTIMONIAL.quote}</p>
        </blockquote>
        <figcaption>
          <strong>{TESTIMONIAL.name}</strong> · {TESTIMONIAL.org}
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .health {
    position: relative;
    overflow: hidden;
    background: var(--brand-navy);
    padding-block: var(--space-section);
  }

  .glow {
    position: absolute;
    inset-block-start: -6rem;
    inset-inline-end: 0;
    inline-size: 16rem;
    block-size: 16rem;
    border-radius: 50%;
    background: rgb(169 209 48 / 0.15);
    filter: blur(48px);
  }

  .card {
    background: var(--white);
    border-radius: calc(var(--radius-media) + 0.25rem);
    box-shadow: var(--shadow-float);
    padding: calc(clamp(var(--space-l), 4vw, 3.5rem) + var(--crown))
      clamp(var(--space-m), 4vw, 3.5rem) clamp(var(--space-l), 4vw, 3.5rem);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
    gap: clamp(var(--space-l), 4vw, 3.5rem);
    align-items: start;
  }

  .card-title {
    font-size: var(--step-2);
  }

  .quote {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    padding-inline-start: clamp(0rem, 3vw, 2.5rem);
    border-inline-start: 1px solid var(--border);

    & blockquote {
      font-family: var(--font-display);
      font-style: italic;
      font-size: 1.375rem;
      line-height: 1.5;
      color: var(--ink);
    }

    & figcaption {
      font-size: 1rem;
      color: var(--ink-muted);
    }

    & strong {
      font-weight: 800;
      color: var(--brand-navy);
    }
  }

  .quote-mark {
    font-family: var(--font-display);
    font-size: 4.5rem;
    line-height: 0.6;
    color: var(--brand-green);
  }

  @media (max-width: 48rem) {
    .quote {
      padding-inline-start: 0;
      border-inline-start: 0;
      padding-block-start: var(--space-l);
      border-block-start: 1px solid var(--border);
    }
  }
</style>
