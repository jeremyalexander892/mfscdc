---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Pillars from "../components/Pillars.astro";
import StatBand from "../components/StatBand.astro";
import Benefits from "../components/Benefits.astro";
import Steps from "../components/Steps.astro";
import HealthCard from "../components/HealthCard.astro";
import About from "../components/About.astro";
import Locations from "../components/Locations.astro";
import ClosingBand from "../components/ClosingBand.astro";
import Footer from "../components/Footer.astro";
import CallBar from "../components/CallBar.astro";
---

<Base title="Correctional Facility Dental Care in LA & TX | Miles For Smiles">
  <Header />
  <main id="main" tabindex="-1">
    <Hero />
    <Pillars />
    <StatBand />
    <Benefits />
    <Steps />
    <HealthCard />
    <About />
    <Locations />
    <ClosingBand />
  </main>
  <Footer />
  <CallBar />
</Base>
